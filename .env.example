# ========================================
# BISTECA Gateway - Environment Variables
# ========================================

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://bisteca:bisteca_dev_2024@localhost:5432/bisteca

# Redis
REDIS_URL=redis://localhost:6379

# URL pública do servidor (usada para auto-registrar o webhook na OpenPix)
BASE_URL=https://bisteca-production.up.railway.app

# Woovi API
WOOVI_API_URL=https://api.woovi.com
WOOVI_APP_ID=SEU_APPID_AQUI

# Webhook Security
# IMPORTANTE: Se definido, este valor é enviado pela OpenPix no header Authorization
# de cada chamada de webhook. Deve ser o mesmo valor configurado em createWebhook({ authorization }).
# Deixe em branco para desabilitar a validação (não recomendado em produção).
WOOVI_WEBHOOK_SECRET=SEU_WEBHOOK_SECRET_AQUI
WEBHOOK_DISPATCH_TIMEOUT_MS=5000

# Platform Settings
PLATFORM_FEE_RATE=0.05
MIN_PAYOUT_AMOUNT=1000
